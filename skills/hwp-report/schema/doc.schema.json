{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "은행 보고서 문서 모델 (HWP 생성용)",
  "description": "LLM은 이 모델만 작성한다. 글꼴·크기·들여쓰기·표 폭 같은 형식은 build_hwp.py가 HWP_SCHEME.md 규칙대로 결정한다.",
  "type": "object",
  "required": ["meta", "blocks"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "date", "dept"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "표지 제목. 16pt 굵게 박스 안" },
        "subtitle": { "type": "string" },
        "date": { "type": "string", "description": "예: 2026.07.31." },
        "dept": { "type": "string", "description": "예: 금융소비자보호부" },
        "font": { "type": "string", "description": "1순위 글꼴. 미설치 시 폴백 (기본 나눔고딕)" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/h1" },
        { "$ref": "#/$defs/h2" },
        { "$ref": "#/$defs/h3" },
        { "$ref": "#/$defs/bullet" },
        { "$ref": "#/$defs/enum" },
        { "$ref": "#/$defs/conclusion" },
        { "$ref": "#/$defs/note" },
        { "$ref": "#/$defs/box" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/pagebreak" },
        { "$ref": "#/$defs/spacer" }
      ]
    },
    "h1": {
      "type": "object",
      "description": "대제목. 배너표(2칸)로 그려진다. num은 로마숫자.",
      "required": ["type", "num", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "h1" },
        "num": { "type": "string", "pattern": "^[ⅠⅡⅢⅣⅤⅥⅦⅧⅨⅩ]\\.?$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "h2": {
      "type": "object",
      "description": "중제목. 번호칸이 반전된 짧은 배너표.",
      "required": ["type", "num", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "h2" },
        "num": { "type": "string", "pattern": "^\\d{1,2}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "h3": {
      "type": "object",
      "description": "소제목. 일반 문단, '1.' 형식.",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "h3" },
        "num": { "type": "string", "pattern": "^\\d{1,2}\\.$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "bullet": {
      "type": "object",
      "description": "본문 불릿. level 1=□, 2=∙, 3=→, 4=-",
      "required": ["type", "level", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "bullet" },
        "level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "text": { "type": "string", "minLength": 1 },
        "bold": { "type": "boolean" },
        "color": { "enum": ["black", "blue"] },
        "marker": { "enum": ["□", "∙", "→", "↳", "-"], "description": "레벨 기본값 대신 강제 지정" }
      }
    },
    "enum": {
      "type": "object",
      "description": "①②③ 순서 열거. 단계·시간순에만 사용.",
      "required": ["type", "index", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "enum" },
        "index": { "type": "integer", "minimum": 1, "maximum": 9 },
        "text": { "type": "string", "minLength": 1 },
        "bold": { "type": "boolean" },
        "color": { "enum": ["black", "blue"] }
      }
    },
    "conclusion": {
      "type": "object",
      "description": "☞ 결론·시사점. 파랑 굵게. 섹션당 2개를 넘기지 않는다.",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "conclusion" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "note": {
      "type": "object",
      "description": "* 각주. 9pt.",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "note" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "box": {
      "type": "object",
      "description": "강조 박스(1행 1열 표). 결론·요약·정의 전용. 6줄 이내.",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "box" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["level", "text"],
            "additionalProperties": false,
            "properties": {
              "level": { "type": "integer", "minimum": 1, "maximum": 4 },
              "text": { "type": "string", "minLength": 1 },
              "bold": { "type": "boolean" },
              "color": { "enum": ["black", "blue"] }
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "description": "데이터표. 열 8개 이하, 중첩 금지, 빈 셀 금지.",
      "required": ["type", "header", "rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "title": { "type": "string", "description": "표 제목(선택). 표 위에 굵게" },
        "caption": { "type": "string", "description": "예: [단위 : 건, %] — 표 위 오른쪽" },
        "header": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "헤더 행. 2행이면 그룹 헤더(병합)",
          "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
        },
        "widths": {
          "type": "array",
          "description": "열 폭. 합이 1 이하면 비율로, 아니면 HWPUNIT으로 해석. 생략 시 균등",
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "align": {
          "type": "array",
          "description": "열별 정렬. 숫자 열은 right 권장",
          "items": { "enum": ["left", "center", "right"] }
        },
        "total_row": { "type": "boolean", "description": "마지막 행을 합계 행으로 굵게" },
        "note": { "type": "string", "description": "표 아래 각주" }
      }
    },
    "pagebreak": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "pagebreak" } }
    },
    "spacer": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "spacer" },
        "lines": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    }
  }
}
